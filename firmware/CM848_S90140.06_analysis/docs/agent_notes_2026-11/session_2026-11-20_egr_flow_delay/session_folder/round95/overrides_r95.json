{
 "structs": {
  "CM550": {
   "table_lookup_1d_arguments_t": [
    [
     "x_axis_offset",
     "word",
     2,
     "the byte offset of the x axis point the previous lookup found (2 = the first point); the search starts there and cm550_lookupTableInterpolation writes it back (the only field it writes)"
    ],
    [
     "x_axis_pointer",
     "word*",
     4,
     "the x axis table: its first word is the byte count of the points that follow (compared unsigned)"
    ],
    [
     "x_input",
     "word",
     2,
     "the x input value (compared unsigned)"
    ],
    [
     "y_values_pointer",
     "word*",
     4,
     "the y values: the value of the x point at byte offset n is read at y_values_pointer + n, so the word at +0 is never read (in a Calterm Y table it is the byte count)"
    ],
    [
     "no_interpolation_flag",
     "word",
     2,
     "nonzero: the lookup returns the value of the point at or below the input without interpolating (no code writes it; 0 in every record of the dump)"
    ]
   ],
   "cm550_j1939_powertrain_messages_received_t": [
    [
     "etc1_status_byte_1",
     "byte",
     1,
     "ETC1 (PGN 61442) data byte 1, stored by the ETC1 handler 0x2efd0"
    ],
    [
     "etc1_bytes_2_to_4",
     "byte",
     3,
     "never written (CM550 keeps no ETC1 output shaft speed)"
    ],
    [
     "etc1_status_byte_5",
     "byte",
     1,
     "ETC1 data byte 5"
    ],
    [
     "etc1_bytes_6_to_8",
     "byte",
     3,
     "never written"
    ],
    [
     "tsc1_control_byte",
     "byte",
     1,
     "TSC1 (PGN 0) data byte 1: the override control mode and priority bits"
    ],
    [
     "tsc1_requested_speed",
     "byte",
     2,
     "TSC1 bytes 2-3 stored high byte first (data[2] at +0 and data[1] at +1)"
    ],
    [
     "tsc1_requested_torque",
     "byte",
     1,
     "TSC1 data byte 4"
    ],
    [
     "tsc1_bytes_5_to_8",
     "byte",
     4,
     "never written"
    ],
    [
     "tsc1_accepted_priority",
     "byte",
     1,
     "the priority of the accepted TSC1 request"
    ],
    [
     "padding_1",
     "byte",
     1,
     "no access (aligns the next word)"
    ],
    [
     "tsc1_accepted_requested_speed",
     "word",
     2,
     "the accepted TSC1 requested speed"
    ],
    [
     "tsc1_accepted_requested_torque",
     "byte",
     1,
     "the accepted TSC1 requested torque"
    ],
    [
     "padding_2",
     "byte",
     1,
     "no access"
    ]
   ],
   "trending_sample_record_t": [
    [
     "oil_pressure",
     "word",
     2,
     "the oil pressure at the sample (sensor 4 filtered)"
    ],
    [
     "boost_pressure",
     "word",
     2,
     "the boost pressure at the sample (sensor 5)"
    ],
    [
     "coolant_temperature",
     "word",
     2,
     "the coolant temperature at the sample (sensor 6)"
    ],
    [
     "average_fuel_consumption",
     "word",
     2,
     "the interval's average fuel consumption (e2m TRAVFLCN)"
    ],
    [
     "average_load",
     "word",
     2,
     "the interval's average load (e2m TRLDINAV)"
    ],
    [
     "time_stamp",
     "dword",
     4,
     "engine_hour_meter with its low byte replaced by throttle_100_fueling >> 8"
    ]
   ]
  }
 },
